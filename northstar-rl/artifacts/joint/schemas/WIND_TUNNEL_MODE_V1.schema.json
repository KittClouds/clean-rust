{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WindTunnelSourceSpec",
  "type": "object",
  "properties": {
    "binding_id": {
      "$ref": "#/$defs/Digest256"
    },
    "mode": {
      "$ref": "#/$defs/WindTunnelMode"
    },
    "mt5_capture_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Digest256"
        },
        {
          "type": "null"
        }
      ]
    },
    "runraw_tape_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Digest256"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "type": "string"
    },
    "source_spec_id": {
      "$ref": "#/$defs/Digest256"
    },
    "tradelocker_capture_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Digest256"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "mode",
    "binding_id",
    "source_spec_id"
  ],
  "$defs": {
    "Digest256": {
      "description": "Domain-separated BLAKE3 digest",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "WindTunnelMode": {
      "type": "string",
      "enum": [
        "RUN_RAW_REPLAY",
        "MT5_CAPTURE_REPLAY",
        "TRADE_LOCKER_CAPTURE_REPLAY",
        "CROSS_SOURCE_COMPARISON"
      ]
    }
  }
}
