{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FeatureTapeHeader",
  "type": "object",
  "properties": {
    "columns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FeatureColumnMeta"
      }
    },
    "compiler_identity": {
      "$ref": "#/$defs/Digest256"
    },
    "content_hash": {
      "$ref": "#/$defs/Digest256"
    },
    "feature_registry_id": {
      "$ref": "#/$defs/Digest256"
    },
    "row_count": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "runraw_tape_id": {
      "$ref": "#/$defs/Digest256"
    },
    "schema_version": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "runraw_tape_id",
    "feature_registry_id",
    "compiler_identity",
    "row_count",
    "columns",
    "content_hash"
  ],
  "$defs": {
    "Digest256": {
      "description": "Domain-separated BLAKE3 digest",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "FeatureColumnMeta": {
      "type": "object",
      "properties": {
        "feature_id": {
          "type": "string"
        },
        "knowledge_times_offset": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "states_offset": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "values_offset": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "feature_id",
        "values_offset",
        "states_offset",
        "knowledge_times_offset"
      ]
    }
  }
}
