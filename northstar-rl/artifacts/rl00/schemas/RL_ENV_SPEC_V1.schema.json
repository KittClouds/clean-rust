{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RlEnvSpec",
  "type": "object",
  "properties": {
    "action_spec_id": {
      "$ref": "#/$defs/Digest256"
    },
    "broker_contract_tape_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Digest256"
        },
        {
          "type": "null"
        }
      ]
    },
    "environment_id": {
      "$ref": "#/$defs/Digest256"
    },
    "episode_spec_id": {
      "$ref": "#/$defs/Digest256"
    },
    "execution_calibration_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Digest256"
        },
        {
          "type": "null"
        }
      ]
    },
    "execution_spec_id": {
      "$ref": "#/$defs/Digest256"
    },
    "extension_implementation_hashes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Digest256"
      }
    },
    "feature_tape_id": {
      "$ref": "#/$defs/Digest256"
    },
    "implementation_hashes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Digest256"
      }
    },
    "instrument_binding_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Digest256"
        },
        {
          "type": "null"
        }
      ]
    },
    "instrument_contract_id": {
      "$ref": "#/$defs/Digest256"
    },
    "market_source_contract": {
      "anyOf": [
        {
          "$ref": "#/$defs/Digest256"
        },
        {
          "type": "null"
        }
      ]
    },
    "numeric_contract_id": {
      "$ref": "#/$defs/Digest256"
    },
    "observation_spec_id": {
      "$ref": "#/$defs/Digest256"
    },
    "reward_spec_id": {
      "$ref": "#/$defs/Digest256"
    },
    "runraw_tape_id": {
      "$ref": "#/$defs/Digest256"
    },
    "schema_version": {
      "type": "string"
    },
    "seed_contract_id": {
      "$ref": "#/$defs/Digest256"
    },
    "termination_spec_id": {
      "$ref": "#/$defs/Digest256"
    },
    "wind_tunnel_mode": {
      "anyOf": [
        {
          "$ref": "#/$defs/WindTunnelMode"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "environment_id",
    "runraw_tape_id",
    "feature_tape_id",
    "observation_spec_id",
    "episode_spec_id",
    "action_spec_id",
    "instrument_contract_id",
    "execution_spec_id",
    "reward_spec_id",
    "termination_spec_id",
    "numeric_contract_id",
    "seed_contract_id",
    "implementation_hashes"
  ],
  "$defs": {
    "Digest256": {
      "description": "Domain-separated BLAKE3 digest",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "WindTunnelMode": {
      "type": "string",
      "enum": [
        "RUN_RAW_REPLAY",
        "MT5_CAPTURE_REPLAY",
        "TRADE_LOCKER_CAPTURE_REPLAY",
        "CROSS_SOURCE_COMPARISON"
      ]
    }
  }
}
