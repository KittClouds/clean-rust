{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReplayReceipt",
  "type": "object",
  "properties": {
    "action_count": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "episode_id": {
      "$ref": "#/$defs/Digest256"
    },
    "policy": {
      "$ref": "#/$defs/ScriptedPolicy"
    },
    "seed": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "terminal_receipt_hash": {
      "$ref": "#/$defs/Digest256"
    },
    "trajectory_root": {
      "$ref": "#/$defs/Digest256"
    }
  },
  "required": [
    "episode_id",
    "seed",
    "policy",
    "action_count",
    "trajectory_root",
    "terminal_receipt_hash"
  ],
  "$defs": {
    "Digest256": {
      "description": "Domain-separated BLAKE3 digest",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ScriptedPolicy": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "policy": {
              "type": "string",
              "const": "ALWAYS_FLAT"
            }
          },
          "required": [
            "policy"
          ]
        },
        {
          "type": "object",
          "properties": {
            "policy": {
              "type": "string",
              "const": "ALWAYS_FULL_POSITIVE"
            }
          },
          "required": [
            "policy"
          ]
        },
        {
          "type": "object",
          "properties": {
            "policy": {
              "type": "string",
              "const": "ALWAYS_FULL_NEGATIVE"
            }
          },
          "required": [
            "policy"
          ]
        },
        {
          "type": "object",
          "properties": {
            "policy": {
              "type": "string",
              "const": "ALTERNATE_EXTREMES"
            }
          },
          "required": [
            "policy"
          ]
        },
        {
          "type": "object",
          "properties": {
            "parameters": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "float"
              }
            },
            "policy": {
              "type": "string",
              "const": "FIXED_ACTION_SEQUENCE"
            }
          },
          "required": [
            "policy",
            "parameters"
          ]
        },
        {
          "type": "object",
          "properties": {
            "policy": {
              "type": "string",
              "const": "SEEDED_RANDOM_ACTIONS"
            }
          },
          "required": [
            "policy"
          ]
        }
      ]
    }
  }
}
