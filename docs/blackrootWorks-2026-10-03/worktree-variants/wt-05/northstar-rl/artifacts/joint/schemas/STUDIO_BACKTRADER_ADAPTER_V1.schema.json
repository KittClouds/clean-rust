{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StudioBacktraderAdapterSpec",
  "type": "object",
  "properties": {
    "adapter_id": {
      "$ref": "#/$defs/Digest256"
    },
    "broker_contract_id": {
      "$ref": "#/$defs/Digest256"
    },
    "northstar_action_spec_id": {
      "$ref": "#/$defs/Digest256"
    },
    "northstar_episode_spec_id": {
      "$ref": "#/$defs/Digest256"
    },
    "northstar_feature_spec_id": {
      "$ref": "#/$defs/Digest256"
    },
    "restrictions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_version": {
      "type": "string"
    },
    "studio_adapter_version": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "northstar_episode_spec_id",
    "northstar_feature_spec_id",
    "northstar_action_spec_id",
    "broker_contract_id",
    "studio_adapter_version",
    "restrictions",
    "adapter_id"
  ],
  "$defs": {
    "Digest256": {
      "description": "Domain-separated BLAKE3 digest",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
