{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BrokerAccountSnapshot",
  "type": "object",
  "properties": {
    "account_id_hash": {
      "$ref": "#/$defs/Digest256"
    },
    "available_funds": {
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "broker_raw_terms": {
      "type": "array",
      "items": {
        "type": "array",
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "number",
            "format": "double"
          }
        ]
      }
    },
    "broker_time_ns": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "cash_equivalent": {
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "content_hash": {
      "$ref": "#/$defs/Digest256"
    },
    "environment": {
      "type": "string"
    },
    "equity": {
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "field_provenance": {
      "type": "array",
      "items": {
        "type": "array",
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "string"
          }
        ]
      }
    },
    "margin_terms": {
      "type": "array",
      "items": {
        "type": "array",
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "number",
            "format": "double"
          }
        ]
      }
    },
    "raw_payload_hash": {
      "$ref": "#/$defs/Digest256"
    },
    "realized_pnl": {
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "received_time_ns": {
      "type": "integer",
      "format": "int64"
    },
    "schema_version": {
      "type": "string"
    },
    "unrealized_pnl": {
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    }
  },
  "required": [
    "schema_version",
    "account_id_hash",
    "environment",
    "broker_raw_terms",
    "margin_terms",
    "received_time_ns",
    "raw_payload_hash",
    "field_provenance",
    "content_hash"
  ],
  "$defs": {
    "Digest256": {
      "description": "Domain-separated BLAKE3 digest",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
