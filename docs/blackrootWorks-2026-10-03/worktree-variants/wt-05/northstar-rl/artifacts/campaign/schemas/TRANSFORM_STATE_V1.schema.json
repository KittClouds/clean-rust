{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TransformState",
  "type": "object",
  "properties": {
    "content_hash": {
      "$ref": "#/$defs/Digest256"
    },
    "fit_role": {
      "$ref": "#/$defs/PartitionRole"
    },
    "fitted_episode_set_hash": {
      "$ref": "#/$defs/Digest256"
    },
    "implementation_hash": {
      "$ref": "#/$defs/Digest256"
    },
    "numeric_contract": {
      "type": "string"
    },
    "ordered_features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FeatureTransformState"
      }
    },
    "partition_tape_id": {
      "$ref": "#/$defs/Digest256"
    },
    "schema_version": {
      "type": "string"
    },
    "source_feature_tape_id": {
      "$ref": "#/$defs/Digest256"
    },
    "transform_state_id": {
      "$ref": "#/$defs/Digest256"
    }
  },
  "required": [
    "schema_version",
    "transform_state_id",
    "source_feature_tape_id",
    "partition_tape_id",
    "fit_role",
    "fitted_episode_set_hash",
    "ordered_features",
    "numeric_contract",
    "implementation_hash",
    "content_hash"
  ],
  "$defs": {
    "Digest256": {
      "description": "Domain-separated BLAKE3 digest",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "FeatureTransformState": {
      "type": "object",
      "properties": {
        "center": {
          "type": "number",
          "format": "double"
        },
        "clip_high": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "clip_low": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "feature_id": {
          "type": "string"
        },
        "fitted_sample_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "method": {
          "$ref": "#/$defs/TransformMethod"
        },
        "missingness_rule": {
          "type": "string"
        },
        "scale": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "feature_id",
        "method",
        "center",
        "scale",
        "fitted_sample_count",
        "missingness_rule"
      ]
    },
    "PartitionRole": {
      "type": "string",
      "enum": [
        "TRAIN",
        "DEVELOPMENT",
        "EVALUATION",
        "EXCLUDED_EMBARGO"
      ]
    },
    "TransformMethod": {
      "type": "string",
      "enum": [
        "IDENTITY",
        "STANDARD_SCORE",
        "ROBUST_MEDIAN_IQR"
      ]
    }
  }
}
