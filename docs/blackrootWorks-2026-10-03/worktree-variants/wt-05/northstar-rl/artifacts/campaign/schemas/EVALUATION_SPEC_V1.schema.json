{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvaluationSpec",
  "type": "object",
  "properties": {
    "aggregation_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deterministic_policy_inference": {
      "type": "boolean"
    },
    "evaluation_episode_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Digest256"
      }
    },
    "evaluation_spec_id": {
      "$ref": "#/$defs/Digest256"
    },
    "implementation_hash": {
      "$ref": "#/$defs/Digest256"
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvaluationMetricRule"
      }
    },
    "partition_tape_id": {
      "$ref": "#/$defs/Digest256"
    },
    "policy_selection_uses_evaluation": {
      "type": "boolean"
    },
    "schema_version": {
      "type": "string"
    },
    "stress_variants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/StressVariant"
      }
    }
  },
  "required": [
    "schema_version",
    "evaluation_spec_id",
    "partition_tape_id",
    "evaluation_episode_ids",
    "deterministic_policy_inference",
    "policy_selection_uses_evaluation",
    "metrics",
    "stress_variants",
    "aggregation_order",
    "implementation_hash"
  ],
  "$defs": {
    "Digest256": {
      "description": "Domain-separated BLAKE3 digest",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "EvaluationMetricRule": {
      "type": "object",
      "properties": {
        "aggregation": {
          "type": "string"
        },
        "direction": {
          "type": "string"
        },
        "metric_id": {
          "type": "string"
        },
        "missingness": {
          "type": "string"
        }
      },
      "required": [
        "metric_id",
        "direction",
        "aggregation",
        "missingness"
      ]
    },
    "StressVariant": {
      "type": "object",
      "properties": {
        "execution_calibration_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest256"
            },
            {
              "type": "null"
            }
          ]
        },
        "parameter_overrides": {
          "type": "array",
          "items": {
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ]
          }
        },
        "stress_id": {
          "type": "string"
        }
      },
      "required": [
        "stress_id",
        "parameter_overrides"
      ]
    }
  }
}
