{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NumericContract",
  "type": "object",
  "properties": {
    "action_float": {
      "type": "string"
    },
    "authority_float": {
      "type": "string"
    },
    "non_finite_policy": {
      "type": "string"
    },
    "numeric_contract_id": {
      "$ref": "#/$defs/Digest256"
    },
    "observation_float": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "numeric_contract_id",
    "authority_float",
    "observation_float",
    "action_float",
    "non_finite_policy"
  ],
  "$defs": {
    "Digest256": {
      "description": "Domain-separated BLAKE3 digest",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
