{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FeatureRegistry",
  "type": "object",
  "properties": {
    "content_hash": {
      "$ref": "#/$defs/Digest256"
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FeatureDeclaration"
      }
    },
    "schema_version": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "features",
    "content_hash"
  ],
  "$defs": {
    "Digest256": {
      "description": "Domain-separated BLAKE3 digest",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "FeatureDType": {
      "type": "string",
      "enum": [
        "float64",
        "float32"
      ]
    },
    "FeatureDeclaration": {
      "type": "object",
      "properties": {
        "dtype": {
          "$ref": "#/$defs/FeatureDType"
        },
        "event_time_semantics": {
          "type": "string"
        },
        "feature_family": {
          "type": "string"
        },
        "feature_id": {
          "type": "string"
        },
        "implementation_hash": {
          "$ref": "#/$defs/Digest256"
        },
        "knowledge_time_semantics": {
          "type": "string"
        },
        "lookback": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "missingness_semantics": {
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ]
          }
        },
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "source_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "transform": {
          "$ref": "#/$defs/FeatureTransform"
        },
        "units": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "warmup": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "feature_id",
        "feature_family",
        "version",
        "dtype",
        "shape",
        "source_dependencies",
        "lookback",
        "warmup",
        "event_time_semantics",
        "knowledge_time_semantics",
        "missingness_semantics",
        "units",
        "transform",
        "parameters",
        "implementation_hash"
      ]
    },
    "FeatureTransform": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "raw_open"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "raw_high"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "raw_low"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "raw_close"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "log_return"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "simple_return"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "candle_range"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "candle_body"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "upper_wick"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "lower_wick"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "rolling_high"
            },
            "window": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "window"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "rolling_low"
            },
            "window": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "window"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "rolling_range"
            },
            "window": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "window"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "rolling_mean"
            },
            "window": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "window"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "rolling_variance"
            },
            "window": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "window"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "rolling_std_dev"
            },
            "window": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "window"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "realized_absolute_movement"
            },
            "window": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "window"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "volume_change"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "time_of_day_sin"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "time_of_day_cos"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "session_progress"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    }
  }
}
