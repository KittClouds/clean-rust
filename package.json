{
  "name": "angular-notes",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:lean": "set NODE_OPTIONS=--max-old-space-size=1536&& ng serve --host 127.0.0.1",
    "desktop:dev": "set CARGO_TARGET_DIR=D:\\cargo-targets\\Angular-build\\tauri-dev&& cargo run --manifest-path src-tauri/Cargo.toml",
    "desktop:check": "set CARGO_TARGET_DIR=D:\\cargo-targets\\Angular-build\\tauri-dev&& cargo check --manifest-path src-tauri/Cargo.toml",
    "desktop:test": "set CARGO_TARGET_DIR=D:\\cargo-targets\\Angular-build\\tauri-dev&& cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "desktop:contract:write": "set CARGO_TARGET_DIR=D:\\cargo-targets\\Angular-build\\tauri-dev&& cargo test --manifest-path src-tauri/Cargo.toml contract_tests::export_phoenix_contract --lib -- --exact",
    "desktop:contract": "npm run desktop:contract:write && git diff --exit-code -- src/app/generated/phoenix-taurpc.ts",
    "desktop:verify-note-crud": "node scripts/verify-note-crud-desktop.mjs",
    "desktop:measure-boot": "node scripts/measure-desktop-boot.mjs",
    "desktop:observe-boot": "node scripts/measure-desktop-boot.mjs --observe-current",
    "corpus:fetch": "node scripts/fetch-document-profile-corpus.mjs",
    "audit:document-profiles": "cargo run --manifest-path rust-native/phoenix/Cargo.toml -p phoenix-chunker --example profile_corpus -- target/document-profile-corpus/manifest.json --output target/document-profile-corpus/report.json",
    "audit:document-sidecar": "vitest run src/app/graph-rebuild/graph-document-corpus-audit.spec.ts",
    "build": "ng build",
    "desktop:build": "npm run build && set CARGO_TARGET_DIR=D:\\cargo-targets\\Angular-build\\tauri-release&& cargo build --release --manifest-path src-tauri/Cargo.toml",
    "watch": "ng build --watch --configuration development",
    "hopf:space": "node scripts/hopf-resonance-space-smoke.mjs",
    "bench:graph:zeroshot": "node scripts/graph-build-zeroshot-baseline.mjs",
    "bench:graph:desktop-two-doc": "node scripts/run-graph-build-desktop-baseline.mjs",
    "audit:graph-taxonomy": "node scripts/graph-atlas-taxonomy-audit.mjs",
    "test": "vitest run",
    "test:graph:unused": "node scripts/check-graph-fast-lane-unused.mjs",
    "test:canvas": "vitest run src/app/lib/services/canvas-note-transaction.spec.ts src/app/lib/services/canvas-note-transaction.service.spec.ts src/app/lib/services/canvas-agent-run.service.spec.ts src/app/lib/services/canvas-surface-parity.spec.ts src/app/lib/services/chat-tool-host.service.spec.ts src/app/lib/operations.spec.ts src/app/services/phoenix-store.service.spec.ts",
    "test:canvas:native": "set CARGO_TARGET_DIR=D:\\phoenix-target-overgraph\\canvas-slice1&& cargo test --manifest-path rust/phoenix/Cargo.toml -p phoenix-runtime canvas_run_opens_a_revision_bound_note_target_and_rejects_stale_revisions --lib",
    "bench:canvas:shortrun": "vitest run src/app/lib/services/canvas-shortrun.performance.spec.ts --reporter=verbose",
    "test:app-ide": "vitest run src/app/lib/services/app-ide-command.contract.spec.ts src/app/lib/services/app-ide-command.service.spec.ts src/app/lib/services/chat-tool-host.service.spec.ts src/app/lib/services/canvas-surface-parity.spec.ts",
    "test:app-ide:native": "set CARGO_TARGET_DIR=D:\\phoenix-target-overgraph\\canvas-slice1&& cargo test --manifest-path rust/phoenix/Cargo.toml -p phoenix-chat run_events_receive_durable_monotonic_sequences_even_at_the_same_timestamp --lib && cargo test --manifest-path rust/phoenix/Cargo.toml -p phoenix-runtime app_ide_ --lib",
    "test:canvas:multi": "vitest run src/app/lib/services/canvas-multi-note-transaction.spec.ts src/app/lib/services/canvas-multi-note-transaction.service.spec.ts src/app/lib/services/canvas-trusted-grant.service.spec.ts src/app/lib/services/chat-tool-host.service.spec.ts src/app/lib/services/canvas-agent-run.service.spec.ts src/app/lib/services/canvas-surface-parity.spec.ts src/app/services/phoenix-store.service.spec.ts",
    "test:canvas:multi:native": "set CARGO_TARGET_DIR=D:\\phoenix-target-overgraph\\canvas-slice3&& cargo test --manifest-path rust/phoenix/Cargo.toml -p phoenix-runtime canvas_multi_note_planner_ --lib",
    "bench:canvas:multi-shortrun": "vitest run src/app/lib/services/canvas-multi-note-shortrun.performance.spec.ts --reporter=verbose",
    "test:watch": "vitest"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.1.0",
  "dependencies": {
    "@angular/animations": "^21.1.1",
    "@angular/cdk": "^21.1.1",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/material": "^21.2.2",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@google/genai": "^1.40.0",
    "@huggingface/transformers": "^4.0.0",
    "@milkdown/core": "^7.18.0",
    "@milkdown/crepe": "^7.18.0",
    "@milkdown/ctx": "^7.18.0",
    "@milkdown/kit": "^7.18.0",
    "@milkdown/prose": "^7.18.0",
    "@milkdown/utils": "^7.18.0",
    "@neurodevworks/angular-chatbot": "^1.0.0",
    "@neurodevworks/chatbot-core": "^1.0.1",
    "@ng-icons/core": ">=32.0.0 <34.0.0",
    "@ng-icons/lucide": ">=32.0.0 <34.0.0",
    "@omnedia/ngx-gradient-text": "^4.0.1",
    "@omnedia/ngx-number-ticker": "^4.0.1",
    "@omnedia/ngx-swapy": "^4.0.1",
    "@omnedia/ngx-timeline": "^4.0.1",
    "@omnedia/ngx-tracing-beam": "^4.0.1",
    "@preact/signals-core": "^1.13.0",
    "@primeng/themes": "^21.0.4",
    "@spartan-ng/brain": "^0.0.1-alpha.609",
    "@spartan-ng/ui-core": "^0.0.1-alpha.380",
    "@types/three": "^0.184.0",
    "@xenova/transformers": "^2.17.2",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.2.1",
    "fflate": "^0.8.2",
    "katex": "^0.16.27",
    "lucide-angular": "^0.562.0",
    "ngx-spinner": "^21.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.0.4",
    "quikchat": "^1.1.17",
    "rxjs": "~7.8.0",
    "swapy": "^1.0.5",
    "tailwind-merge": "^3.4.0",
    "taurpc": "^1.8.1",
    "three": "^0.184.0",
    "tslib": "^2.3.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.1",
    "@angular/cli": "^21.1.1",
    "@angular/compiler-cli": "^21.1.0",
    "@angular/platform-browser-dynamic": "^21.1.4",
    "@spartan-ng/cli": "^0.0.1-alpha.609",
    "autoprefixer": "^10.4.23",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2",
    "vitest": "^4.0.18",
    "zone.js": "^0.16.0"
  }
}
