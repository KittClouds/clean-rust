{
  "name": "angular-notes",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:lean": "set NODE_OPTIONS=--max-old-space-size=1536&& ng serve --host 127.0.0.1",
    "desktop:dev": "cargo run --manifest-path src-tauri/Cargo.toml",
    "desktop:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "build": "ng build",
    "desktop:build": "npm run build && cargo build --release --manifest-path src-tauri/Cargo.toml",
    "watch": "ng build --watch --configuration development",
    "hopf:space": "node scripts/hopf-resonance-space-smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.1.0",
  "dependencies": {
    "@angular/animations": "^21.1.1",
    "@angular/cdk": "^21.1.1",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/material": "^21.2.2",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@google/genai": "^1.40.0",
    "@huggingface/transformers": "^4.0.0",
    "@milkdown/core": "^7.18.0",
    "@milkdown/crepe": "^7.18.0",
    "@milkdown/ctx": "^7.18.0",
    "@milkdown/kit": "^7.18.0",
    "@milkdown/prose": "^7.18.0",
    "@milkdown/utils": "^7.18.0",
    "@neurodevworks/angular-chatbot": "^1.0.0",
    "@neurodevworks/chatbot-core": "^1.0.1",
    "@ng-icons/core": ">=32.0.0 <34.0.0",
    "@ng-icons/lucide": ">=32.0.0 <34.0.0",
    "@omnedia/ngx-gradient-text": "^4.0.1",
    "@omnedia/ngx-number-ticker": "^4.0.1",
    "@omnedia/ngx-swapy": "^4.0.1",
    "@omnedia/ngx-timeline": "^4.0.1",
    "@omnedia/ngx-tracing-beam": "^4.0.1",
    "@preact/signals-core": "^1.13.0",
    "@primeng/themes": "^21.0.4",
    "@spartan-ng/brain": "^0.0.1-alpha.609",
    "@spartan-ng/ui-core": "^0.0.1-alpha.380",
    "@types/three": "^0.184.0",
    "@xenova/transformers": "^2.17.2",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.2.1",
    "katex": "^0.16.27",
    "lucide-angular": "^0.562.0",
    "ngx-spinner": "^21.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.0.4",
    "quikchat": "^1.1.17",
    "rxjs": "~7.8.0",
    "swapy": "^1.0.5",
    "tailwind-merge": "^3.4.0",
    "taurpc": "^1.8.1",
    "three": "^0.184.0",
    "tslib": "^2.3.0",
    "uuid": "^13.0.0"
