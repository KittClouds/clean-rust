  "split_rule": "Sort by SHA256(UTF8(\"FAS-R1-SENSOR-SPLIT-v01\\0\" + family_id)); first 48 train, next 16 validation, final 32 qualification. Family-level only.",
  "split_counts": {
    "train": 48,
    "validation": 16,
    "qualification": 32
  },
  "qualification_scope": "engineering sensor qualification only; generator has two paraphrase templates and is not a broad natural-language stress corpus",
  "action_relevance_support": {
    "states_per_family": 32,
    "assignment_sampler": {
      "population": "all complete assignments in [0,k)^n, sampled uniformly by one role draw per entity",
      "state_indexing": "for each family task_id and state_index 0..31, independently initialize the PRNG",
      "seed": "little-endian u64 from the first eight bytes of SHA256(UTF8(\"FAS-R1-ACTION-PROBE-v01\\0\" + task_id + \"\\0\" + decimal(state_index)))",
      "prng": "SplitMix64: state += 0x9e3779b97f4a7c15; z=(z^(z>>30))*0xbf58476d1ce4e5b9; z=(z^(z>>27))*0x94d049bb133111eb; output=z^(z>>31), all arithmetic modulo 2^64",
      "role_draw": "next_u64 modulo k for entity indices 0..n-1"
    },
    "edits_per_state": "enumerate every one-entity role change except no-op",
    "label": "for every candidate edit, count satisfied typed clauses before and after; label -1/0/+1 by the sign of the integer difference; each typed clause contributes one",
    "qualification_minimum": {
      "examples_per_sign_class": 100,
      "distinct_qualification_families_per_sign_class": 20
    },
    "sampling_is_class_stratified": false
  },
  "gates": {
    "semantic_identity_balanced_accuracy_min": 0.9,
    "binding_entity_role_f1_min": 0.9,
    "action_relevance_heldout_macro_f1_min": 0.9,
    "failure_action": "record rung failure, diagnose interface and issue a versioned support/adapter repair; do not erase failed run or infer a passing sensor claim"
  },
