  "mixture": {
    "train_cells": [
      {
        "source_kind": "random_complete",
        "label": 0,
        "weight": 0.25
      },
      {
        "source_kind": "random_complete",
        "label": 1,
        "weight": 0.25
      },
      {
        "source_kind": "policy_visited",
        "label": 0,
        "weight": 0.25
      },
      {
        "source_kind": "policy_visited",
        "label": 1,
        "weight": 0.25
      }
