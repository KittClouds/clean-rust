    "prepared_sample_storage": "individual-npy-arrays-without-pickle",
    "feature_id": "opaque identity for one exact rendered input surface",
    "h_constraints": "float32[T,M,2048]",
    "constraint_mask": "bool[T,M]",
    "h_global": "float32[T,2048]",
    "entity_incidence": "bool[T,M,20]",
    "role_incidence": "bool[T,M,6]",
    "n_by_feature": "uint16[T]",
    "k_by_feature": "uint8[T]",
    "padding": "right-pad M/N/K; masks false on padding; never truncate",
    "max_constraints": 512,
    "max_entities": 20,
    "max_roles": 6,
    "model_input_surface": "H=(constraint embeddings, constraint mask, public entity/role incidence, public active entity/role masks), h_global, a"
