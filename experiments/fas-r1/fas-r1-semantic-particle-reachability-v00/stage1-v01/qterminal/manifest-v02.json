      {
        "source_kind": "random_complete",
        "label": 0,
        "weight": 0.5
      },
      {
        "source_kind": "random_complete",
        "label": 1,
        "weight": 0.5
      }
    ],
    "sampling": "deterministic-without-replacement-by-sha256-order",
    "sampling_seed": 20260926,
    "per_family_per_cell_cap": 4,
    "matched_cell_size": "minimum_available_cell_count_after_per_family_cap",
    "maximum_rows_per_cell_per_split": 100000,
    "deduplicate_key": [
      "feature_id",
      "source_kind",
      "assignment"
    ],
    "require_nonempty_all_four_train_cells": true,
    "require_nonempty_two_heldout_random_cells": true,
    "policy_trace_labels_only_from_training_families": true,
    "no_oversampling": true
  },
  "policy_trace_source": {
    "policy_checkpoint_id": "R1_QTERMINAL_BASELINE_VISITATION_V1",
    "implementation": "Stage 0 RANDOM-WIDTH stub arm",
    "proposal_mode": "uniform_random_stub",
    "width": 1,
    "expansion_budget": 256,
    "latent_dim": 1,
    "replicates_per_training_family": 4,
    "trace_seed": "big-endian-uint64-prefix-of-sha256(FAS-R1-QTERM-TRACE-V1\u0000family_id\u0000replicate_index)",
    "sampled_states": "initial assignment plus every complete assignment_after event",
    "posthoc_labels": "independent_typed_validator_v1 after trace closure",
    "worlds": "training families only",
    "learned_proposal_required": false,
    "latent_state_note": "Stage 0 requires a positive latent_dim; the one-coordinate stub state is inert under uniform_random_stub and is not a learned control state."
  },
  "random_assignment_source": {
    "sampler_id": "R1_QTERMINAL_CLASS_CONDITIONED_ASSIGNMENTS_V1",
    "candidate_count_per_feature_per_label": 4,
    "valid_assignment_sampling": "uniform without replacement from exact validator solution assignments",
    "invalid_assignment_sampling": "uniform complete assignments conditioned on validator-invalid, using rejection sampling",
    "invalid_sampling_attempt_limit": 1000000,
    "empty_class_support": "emit zero candidates for a task/class when that class is mathematically empty; balance only across supported split-level cells and never synthesize labels",
    "seed": "big-endian-uint64-prefix-of-sha256(FAS-R1-QTERM-RANDOM-V1\u0000feature_id\u0000replicate_index)",
    "prng": "SplitMix64 with unbiased rejection-sampled bounded integers",
    "role_draw_order": "entity order, each role sampled uniformly from [0,k)",
    "duplicate_assignments": "discard within feature_id and source_kind"
  },
  "feature_input": {
    "schema": "R1_FEATURE_ARRAYS_V1",
    "source_schema": "R1_STAGE1_SENSOR_EXTRACTION_V01",
