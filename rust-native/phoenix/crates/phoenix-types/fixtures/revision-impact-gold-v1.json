{
  "schemaVersion": "phoenix-revision-impact-gold/v1",
  "contractSchemaVersion": 1,
  "cases": [
    {
      "caseId": "gold:delayed_reveal",
      "family": "delayed_reveal",
      "title": "Silas learns Kai exists in chapter twelve instead of chapter four",
      "mutation": {
        "kind": "shift_validity",
        "factId": "fact:silas_knows_kai",
        "newInterval": {
          "validFrom": 1200,
          "validToExclusive": null
        }
      },
      "expectedImpacts": [
        {
          "sceneId": "scene:chapter_5_iriane_assignment",
          "classification": "broken",
          "constraintKinds": [
            "requires_knowledge"
          ],
          "rationale": "Iriane says Silas sent her specifically for Kai before Silas can know Kai exists."
        },
        {
          "sceneId": "scene:chapter_8_temporal_signature",
          "classification": "broken",
          "constraintKinds": [
            "requires_knowledge"
          ],
          "rationale": "Silas identifies Kai's temporal signature before the shifted reveal."
        },
        {
          "sceneId": "scene:chapter_10_hazel_assumption",
          "classification": "suspicious",
          "constraintKinds": [
            "causal_support"
          ],
          "rationale": "Hazel's assumption that Silas is already involved loses its strongest support."
        }
      ],
      "expectedUnknowns": [
        {
          "sceneId": "scene:chapter_6_combat",
          "missingPlanes": [
            "capability"
          ],
          "rationale": "The combat appears unrelated, but capability-rule coverage is intentionally unavailable."
        }
      ],
      "reasonableRepairs": [
        {
          "repairId": "edit:reassign_causal_attribution:iriane_event_trail",
          "kind": "reassign_causal_attribution",
          "targetSceneIds": [
            "scene:chapter_5_iriane_assignment",
            "scene:chapter_8_temporal_signature",
            "scene:chapter_10_hazel_assumption"
          ],
          "rationale": "Keep Silas wholly unaware until chapter twelve while Iriane independently follows unintended consequences of the missing friend's past actions."
        }
      ],
      "reviewStatus": "author_reviewed",
      "reviewedBy": "author:workspace-owner",
      "reviewedAtUnixMs": 1784295149199
    },
    {
      "caseId": "gold:earlier_death",
      "family": "earlier_death",
      "title": "Mara dies before the siege instead of after it",
      "mutation": {
        "kind": "change_state",
        "subjectId": "entity:mara",
        "stateKind": "alive",
        "replacement": {
          "kind": "boolean",
          "value": false
        },
        "validFrom": 700
      },
      "expectedImpacts": [
        {
          "sceneId": "scene:chapter_9_mara_warning",
          "classification": "broken",
          "constraintKinds": [
            "requires_alive"
          ],
          "rationale": "Mara directly warns Kai after the revised death boundary."
        },
        {
          "sceneId": "scene:chapter_11_faction_response",
          "classification": "suspicious",
          "constraintKinds": [
            "causal_support"
          ],
          "rationale": "The faction response still works, but its stated motivation depends on Mara's later actions."
        }
      ],
      "expectedUnknowns": [
        {
          "sceneId": "scene:chapter_12_resurrection_rumor",
          "missingPlanes": [
            "lifecycle",
            "capability"
          ],
          "rationale": "The scene may be legal if resurrection exists, but that rule plane is not covered."
        }
      ],
      "reasonableRepairs": [
        {
          "repairId": "edit:rebind_warning_to_prerecorded_message:mara",
          "kind": "rebind_action_to_prior_record",
          "targetSceneIds": [
            "scene:chapter_9_mara_warning",
            "scene:chapter_11_faction_response",
            "scene:chapter_12_resurrection_rumor"
          ],
          "rationale": "Keep Mara definitively dead, deliver her prerecorded warning later, ground the faction response in her legacy and type resurrection claims as false rumors."
        }
      ],
      "reviewStatus": "author_reviewed",
      "reviewedBy": "author:workspace-owner",
      "reviewedAtUnixMs": 1784295149199
