    {
      "caseId": "gold:changed_power_limitation",
      "family": "changed_power_limitation",
      "title": "Kai can take only two temporal steps before recovery",
      "mutation": {
        "kind": "supersede_fact",
        "factId": "fact:kai_temporal_step_limit",
        "replacement": {
          "kind": "integer",
          "value": 2
        },
        "validFrom": 300
      },
      "expectedImpacts": [
        {
          "sceneId": "scene:chapter_6_three_step_escape",
          "classification": "broken",
          "constraintKinds": [
            "requires_state"
          ],
          "rationale": "Kai performs three consecutive temporal steps without the required recovery."
        },
        {
          "sceneId": "scene:chapter_10_training_strategy",
          "classification": "suspicious",
          "constraintKinds": [
            "causal_support"
          ],
          "rationale": "The training strategy assumes the former higher limit and becomes less convincing."
        }
      ],
      "expectedUnknowns": [
        {
          "sceneId": "scene:chapter_12_artifact_amplification",
          "missingPlanes": [
            "capability"
          ],
          "rationale": "The artifact may override the limitation, but amplification rules are unavailable."
        }
      ],
      "reasonableRepairs": [
        {
          "repairId": "edit:split_power_rule_into_safe_limit_and_overdraw:kai",
          "kind": "add_costed_capability_overdraw",
          "targetSceneIds": [
            "scene:chapter_6_three_step_escape",
            "scene:chapter_10_training_strategy",
            "scene:chapter_12_artifact_amplification"
          ],
          "rationale": "Treat two steps as Kai's safe limit, make an unaided third cause physical injury and unconsciousness, and let the artifact raise the safe limit to exactly three."
        }
      ],
      "reviewStatus": "author_reviewed",
      "reviewedBy": "author:workspace-owner",
      "reviewedAtUnixMs": 1784295149199
    },
    {
      "caseId": "gold:changed_travel_duration",
      "family": "changed_travel_duration",
      "title": "Travel from Veyra to the northern fort takes eight hours",
      "mutation": {
        "kind": "supersede_fact",
        "factId": "fact:veyra_to_northern_fort_travel_minutes",
        "replacement": {
          "kind": "duration_minutes",
          "value": 480
        },
        "validFrom": 0
      },
      "expectedImpacts": [
        {
          "sceneId": "scene:chapter_8_same_evening_arrival",
          "classification": "broken",
          "constraintKinds": [
            "requires_reachability",
            "requires_temporal_order"
          ],
          "rationale": "The party arrives before the revised minimum travel interval can elapse."
        },
        {
          "sceneId": "scene:chapter_9_pursuit_pressure",
          "classification": "suspicious",
          "constraintKinds": [
            "foreshadowing"
          ],
          "rationale": "The pursuit remains possible, but its compressed timing loses tension and clarity."
        }
      ],
      "expectedUnknowns": [
        {
          "sceneId": "scene:chapter_7_portal_rumor",
          "missingPlanes": [
            "location",
            "capability"
          ],
          "rationale": "A portal could restore reachability, but its existence and travel rules are not covered."
        }
      ],
      "reasonableRepairs": [
        {
          "repairId": "edit:route_arrival_through_constrained_portal",
          "kind": "add_constrained_travel_method",
          "targetSceneIds": [
            "scene:chapter_7_portal_rumor",
            "scene:chapter_8_same_evening_arrival",
            "scene:chapter_9_pursuit_pressure"
          ],
          "rationale": "Keep ordinary travel at eight hours while establishing a real portal with fixed endpoints, costly activation, limited passengers and a long cooldown."
        }
      ],
      "reviewStatus": "author_reviewed",
      "reviewedBy": "author:workspace-owner",
      "reviewedAtUnixMs": 1784295149199
    },
